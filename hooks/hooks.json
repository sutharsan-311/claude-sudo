{
  "description": "Routes sudo password prompts to the keyring and asks for approval in the CLI",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/sudo-guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
